# data / spreadsheets
*.csv
*.xlsm
*.xlsx

# generated toolkit artifacts
*.pseries
*.mfunc
*.cfunc
*.oscillator

# rendered media
*.mp4

# installers (distributed via GitHub Releases, not tracked in the repo).
# Only the installers are ignored - run.command / run.bat ARE tracked, so the
# clone delivers them into the installed folder.
installer.command
installer.bat

# app runtime state
chronopolis_prefs.json

# python caches
__pycache__/
*.pyc

# environments / editor
/.claude/
/.venv/
